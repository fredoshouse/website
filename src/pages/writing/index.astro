---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getAllWriting } from "../../lib";
import Subscribe from "../../components/Subscribe.astro";
import { SERIES, NEWSLETTER } from "../../site";

const posts = await getAllWriting();
const groups = Object.entries(SERIES)
  .map(([key, meta]) => ({ ...meta, posts: posts.filter((p) => p.series === key) }))
  .filter((g) => g.posts.length > 0);
---

<Base title="Writing" description="Stuff I've learned doing growth and ops, written down so I don't forget it.">
  <h1>Writing</h1>
  <p class="lede">
    Stuff I've learned doing growth and ops, written down so I don't forget it.
  </p>
  <Subscribe />
  <p class="muted">
    {NEWSLETTER.url || NEWSLETTER.embedId ? "Or grab the " : "Want new ones? There's an "}
    <a href="/rss.xml">RSS feed</a>.
  </p>

  {
    groups.map((g) => (
      <section>
        <p class="label">{g.name}</p>
        <p class="muted">{g.blurb}</p>
        <PostList posts={g.posts} />
      </section>
    ))
  }
</Base>
