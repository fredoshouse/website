---
import Base from "../layouts/Base.astro";
import { SITE } from "../site";

const jobs = [
  {
    name: "Ghost Note",
    href: "https://www.ghostnoteagency.com",
    role: "growth",
    body: "I bring in new business. That means meeting people, figuring out what they actually need, and turning good conversations into good clients.",
  },
  {
    name: "Integral",
    role: "operations",
    body: "I keep the machine running. Timelines, handoffs, who's doing what, and making sure the work ships without everyone losing their minds.",
  },
  {
    name: "Fredo's House",
    role: "my own thing",
    body: "Where I write, try out ideas, and sometimes help founders and agencies get their ops in order.",
  },
];
---

<Base title="Work" description="Growth at Ghost Note, ops at Integral, and Fredo's House on the side.">
  <h1>What I do</h1>
  <p class="lede">
    Two jobs, one side thing, and usually 10 to 20 accounts going at once.
  </p>

  {
    jobs.map((j) => (
      <>
        <p class="label">{j.role}</p>
        <h3>{j.href ? <a href={j.href}>{j.name}</a> : j.name}</h3>
        <p>{j.body}</p>
      </>
    ))
  }

  <p class="label">want help?</p>
  <p>
    If your team is buried and needs someone to sort out how the work gets
    done, email me:{" "}
    <a href={`mailto:${SITE.email}?subject=Hey%20Fredo`}>{SITE.email}</a>.
  </p>
</Base>

<style>
  h3 {
    margin-top: 0;
  }
  h3 a {
    text-decoration: none;
  }
</style>
