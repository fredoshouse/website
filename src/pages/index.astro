---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib";
import { SITE } from "../site";

const recent = (await getPosts()).slice(0, 5);
---

<Base>
  <h2 class="welcome">Hey, I'm Fredo.</h2>
  <p>
    Alfred on paper, Fredo to everyone else. I'm the person who makes sure
    things actually get done.
  </p>

  <p class="label">present</p>
  <p>Most of my time goes to two places:</p>
  <p>
    <strong>Growth at <a href="https://www.ghostnoteagency.com">Ghost Note</a>.</strong>{" "}
    Finding new clients, building relationships, and helping the agency grow.
  </p>
  <p>
    <strong>Operations at Integral.</strong> Keeping projects moving, keeping
    people unblocked, and making sure nothing falls through the cracks.
  </p>
  <p>
    On any given week I'm running somewhere between 10 and 20 different
    accounts. It's probably the African in me. Working hard is the only mode I
    was ever taught.
  </p>
  <p>
    The rest of the time I'm trying to keep my own life afloat and have some
    fun in {SITE.location}.
  </p>

  <p class="label">past</p>
  <p>
    I started out as a creative project manager and figured out pretty quickly
    I'm not really a project manager. I'm an operator. That's where{" "}
    <a href="/work">Fredo's House</a> came from.
  </p>

  {
    recent.length > 0 && (
      <>
        <p class="label">stuff I've written</p>
        <PostList posts={recent} />
        <p style="margin-top:1rem">
          <a href="/writing">All of it →</a>
        </p>
      </>
    )
  }

  <p class="label">say hi</p>
  <p>
    Just email me: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. Work
    stuff, Seattle recs, whatever. I read everything.
  </p>
</Base>

<style>
  .welcome {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    margin-top: 0;
  }
</style>
