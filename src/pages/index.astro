---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import Ticker from "../components/Ticker.astro";
import RightNow from "../components/RightNow.astro";
import Timeline from "../components/Timeline.astro";
import Subscribe from "../components/Subscribe.astro";
import { getAllWriting } from "../lib";
import { SITE } from "../site";

const recent = (await getAllWriting()).slice(0, 5);
---

<Base>
  <Ticker />

  <h2 class="welcome">Hey, I’m Fredo.</h2>
  <p>Alfred on paper. Fredo to everyone else.</p>
  <p>
    I spend most of my time doing two things: growth at{" "}
    <a href="https://www.ghostnoteagency.com">Ghost Note</a> and operations at
    Integral.
  </p>
  <p>
    At Ghost Note, I work on the growth side of the business — finding new
    opportunities, meeting people, building relationships, and figuring out how
    to turn a good conversation into good work.
  </p>
  <p>
    At Integral, I’m more behind the scenes. I help keep the work moving —
    clients, timelines, people, budgets, handoffs, and all the random stuff that
    has to happen for a team to do its best work.
  </p>
  <p>Most weeks I’m somewhere between 10 and 20 different accounts at once.</p>
  <p>
    It’s a lot. But I like being in the middle of things. I like figuring out
    what’s stuck, making the right connection, and getting people moving again.
  </p>
  <p>
    I think it’s probably my African upbringing. Working hard is the only mode I
    was really taught.
  </p>
  <p>But work isn’t the whole thing.</p>
  <p>
    I’m also trying to build a life I actually enjoy. I’m in Seattle now, which
    means I’m trying to explore the city, meet good people, spend time with the
    people I care about, travel when I can, and have some fun in between all the
    work.
  </p>
  <p>I’m still figuring out the balance.</p>

  <Timeline />

  <RightNow />

  {
    recent.length > 0 && (
      <>
        <p class="label">stuff I’ve written</p>
        <PostList posts={recent} />
        <p style="margin-top:1rem">
          <a href="/writing">All of it →</a>
        </p>
        <Subscribe />
      </>
    )
  }

  <p class="label">if you want to talk</p>
  <p>
    If you’re building something, running an agency, trying to grow a business,
    or just want to grab a coffee and talk about what’s going on:
  </p>
  <p><a href={`mailto:${SITE.email}`} data-track="email click">{SITE.email}</a></p>
  <p>I read everything.</p>
</Base>

<style>
  .welcome {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    margin-top: 0;
  }
</style>
