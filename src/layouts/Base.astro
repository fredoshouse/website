---
import "../styles/global.css";
import { SITE, NAV, ELSEWHERE } from "../site";
import Analytics from "../components/Analytics.astro";
import Corners from "../components/Corners.astro";
import NowPlaying from "../components/NowPlaying.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply the saved theme before first paint so there's no flash.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eef2f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161b24" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Corners />
    <header class="site-header">
      <a href="/" class="home">
        <span class="name">{SITE.name}</span>
        <span class="tagline">{SITE.tagline}</span>
      </a>
      <nav aria-label="Main" class="wrap">
        {
          NAV.map((n) => (
            <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap site-footer">
      <span>© {new Date().getFullYear()} {SITE.name} · Fredo's House</span>
      <span class="links">
        {ELSEWHERE.map((l) => <a href={l.href} data-track="elsewhere click" data-track-label={l.label}>{l.label}</a>)}
      </span>
    </footer>
    <NowPlaying />
    <Analytics />
  </body>
</html>

<style>
  .site-header {
    text-align: center;
    padding-top: 4.5rem;
    margin-bottom: 3.5rem;
  }
  .home {
    display: inline-block;
    text-decoration: none;
    padding: 0 1.25rem 1.5rem;
  }
  .home:hover {
    color: inherit;
  }
  .name {
    display: block;
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(2.25rem, 8vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .tagline {
    display: block;
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem clamp(1rem, 4vw, 2rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--fg);
    max-width: 44rem;
    font-family: var(--sans);
    font-size: 1.05rem;
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--fg);
  }
  nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    margin-top: 6rem;
    padding-top: 1.5rem;
    padding-bottom: 6rem;
    border-top: 1px solid var(--faint);
    font-family: var(--sans);
    font-size: 0.875rem;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 1rem;
  }
</style>
