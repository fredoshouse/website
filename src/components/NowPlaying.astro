---
// The song on repeat, pinned to the bottom of the screen as you scroll.
import { getNow } from "../lib";

const song = (await getNow()).listening;
const href =
  song.href || `https://open.spotify.com/search/${encodeURIComponent(`${song.title} ${song.by}`)}`;
---

<a
  class="now-playing"
  href={href}
  target="_blank"
  rel="noopener"
  data-track="song click"
  data-track-title={song.title}
  aria-label={`On repeat: ${song.title} by ${song.by}`}
>
  <span class="art" aria-hidden="true">
    {song.image ? <img src={song.image} alt="" /> : "♪"}
  </span>
  <span class="text">
    <span class="k">on repeat</span>
    <span class="t">
      {song.title}
      {song.by && <span class="by"> · {song.by}</span>}
    </span>
  </span>
  <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
</a>

<style>
  .now-playing {
    position: fixed;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 1rem);
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: max-content;
    max-width: calc(100vw - 2rem);
    padding: 0.4rem 1rem 0.4rem 0.4rem;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    font-family: var(--sans);
    line-height: 1.15;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.2);
  }
  .now-playing:hover {
    color: var(--bg);
    background: var(--accent);
  }
  .art {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    overflow: hidden;
    flex: none;
    background: color-mix(in srgb, var(--bg) 18%, transparent);
  }
  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text {
    display: grid;
    min-width: 0;
  }
  .k {
    font-size: 0.65rem;
    opacity: 0.7;
  }
  .t {
    font-size: 0.88rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .by {
    font-weight: 400;
    opacity: 0.75;
  }
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 0.9rem;
    flex: none;
  }
  .bars i {
    width: 3px;
    height: 40%;
    border-radius: 2px;
    background: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bars i {
      animation: eq 1s ease-in-out infinite;
    }
    .bars i:nth-child(2) {
      animation-delay: -0.3s;
    }
    .bars i:nth-child(3) {
      animation-delay: -0.6s;
    }
    .bars i:nth-child(4) {
      animation-delay: -0.15s;
    }
    @keyframes eq {
      50% {
        height: 100%;
      }
    }
  }
</style>
