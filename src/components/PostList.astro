---
import type { WritingItem } from "../lib";
import { formatDate } from "../lib";

interface Props {
  posts: WritingItem[];
}

const { posts } = Astro.props;
---

<ul class="rows">
  {
    posts.map((post) => (
      <li>
        <a
          href={post.href}
          data-track="writing click"
          data-track-title={post.title}
          data-track-series={post.series}
        >
          {post.title}
          {post.external && <span class="ext" aria-label="(opens on beehiiv)">↗</span>}
        </a>
        <time class="meta" datetime={post.date.toISOString()}>
          {formatDate(post.date)}
        </time>
      </li>
    ))
  }
</ul>

<style>
  .ext {
    margin-left: 0.3em;
    font-size: 0.8em;
    color: var(--muted);
  }
</style>
