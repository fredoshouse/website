---
import { getNow, formatDate } from "../lib";

const now = await getNow();
const updated = new Date(now.updated);
const cards = [
  { label: "reading", item: now.reading },
  { label: "on repeat", item: now.listening },
];
const showMoodboard = now.moodboard.length > 0 || import.meta.env.DEV;
---

<section id="right-now">
  <p class="label">
    right now <span class="updated">· updated {formatDate(updated, "long")}</span>
  </p>

  <div class="cards">
    {
      cards.map(({ label, item }) => (
        <div class="card">
          {item.image ? (
            <img src={item.image} alt="" loading="lazy" />
          ) : (
            <div class="art" aria-hidden="true">{item.title.slice(0, 1)}</div>
          )}
          <div>
            <p class="k">{label}</p>
            <p class="title">
              {item.href ? <a href={item.href}>{item.title}</a> : item.title}
            </p>
            {item.by && <p class="by">{item.by}</p>}
            {item.take && <p class="take">“{item.take}”</p>}
          </div>
        </div>
      ))
    }
  </div>

  <div class="count">
    <span class="big">{now.accounts}</span>
    <span>accounts going at once. It's a lot. I like it.</span>
  </div>

  <p class="k">on my mind</p>
  <ul class="mind">
    {
      now.onMyMind.map((m) => (
        <li>
          <time datetime={m.date}>{formatDate(new Date(m.date))}</time>
          <span>{m.text}</span>
        </li>
      ))
    }
  </ul>

  {
    showMoodboard && (
      <>
        <p class="k">moodboard</p>
        <div class="mood">
          {now.moodboard.length > 0
            ? now.moodboard.map((p) => <img src={p.src} alt={p.alt} loading="lazy" />)
            : Array.from({ length: 6 }, () => (
                <div class="empty">add photos to public/moodboard</div>
              ))}
        </div>
      </>
    )
  }
</section>

<style>
  .updated {
    color: var(--muted);
    opacity: 0.8;
  }
  .k {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0 0 0.25rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--faint);
    border-radius: 10px;
    background: color-mix(in srgb, var(--bg) 70%, white);
  }
  .card img,
  .art {
    width: 64px;
    height: 64px;
    flex: none;
    border-radius: 6px;
    object-fit: cover;
  }
  .art {
    display: grid;
    place-items: center;
    background: var(--faint);
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--muted);
  }
  .title {
    margin: 0;
    line-height: 1.3;
  }
  .by {
    margin: 0.1rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .take {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    font-style: italic;
  }
  .count {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 2rem 0;
  }
  .big {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 2.5rem;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  .mind {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }
  .mind li {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--faint);
  }
  .mind time {
    flex: none;
    width: 4.5rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
    padding-top: 0.25rem;
  }
  .mood {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  .mood img,
  .empty {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
  }
  .empty {
    display: grid;
    place-items: center;
    text-align: center;
    padding: 0.5rem;
    border: 1px dashed var(--faint);
    font-family: var(--sans);
    font-size: 0.7rem;
    color: var(--muted);
  }
  @media (prefers-color-scheme: dark) {
    .card {
      background: color-mix(in srgb, var(--bg) 85%, white);
    }
  }
</style>
