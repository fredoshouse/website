---
// Vertical timeline: every year from TIMELINE_START to now. Years with a
// stop get an emoji and a card; the rest are small ticks on the line.
import { getTimeline } from "../timeline";

const years = getTimeline().reverse(); // newest at the top
---

<ol class="timeline">
  {
    years.map(({ year, stop, now }) => (
      <li class:list={["year", { filled: stop, now }]}>
        <span class="when">{now ? `${year} · now` : year}</span>
        <span class="dot" aria-hidden="true">
          {stop && (stop.icon || "•")}
        </span>
        {stop && (
          <div class="body">
            <p class="title">{stop.title}</p>
            {stop.where && (
              <p class="where">{stop.href ? <a href={stop.href}>{stop.where}</a> : stop.where}</p>
            )}
            {stop.note && <p class="note">{stop.note}</p>}
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    --when: 5rem;
    --dot: 2.5rem;
    --gap: 1rem;
    list-style: none;
    margin: 2rem 0;
    padding: 0;
    position: relative;
  }
  /* the line */
  .timeline::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: calc(var(--when) + var(--gap) + var(--dot) / 2);
    width: 1px;
    background: var(--faint);
  }
  .year {
    position: relative;
    display: grid;
    grid-template-columns: var(--when) var(--dot) 1fr;
    align-items: start;
    column-gap: var(--gap);
    min-height: 1.6rem;
  }
  .year.filled {
    padding: 0.75rem 0 1.5rem;
  }
  .when {
    text-align: right;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.6rem;
  }
  .filled .when {
    color: var(--fg);
    font-weight: 700;
    line-height: var(--dot);
  }
  .now .when {
    color: var(--accent);
  }
  .dot {
    justify-self: center;
    width: 0.45rem;
    height: 0.45rem;
    margin-top: 0.575rem;
    border-radius: 50%;
    background: var(--faint);
    position: relative;
  }
  .filled .dot {
    display: grid;
    place-items: center;
    width: var(--dot);
    height: var(--dot);
    margin-top: 0;
    background: var(--bg);
    border: 1px solid var(--faint);
    font-size: 1.15rem;
    line-height: 1;
  }
  .now .dot {
    border-color: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .body {
    padding-top: 0.35rem;
  }
  .title {
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .where {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .note {
    margin: 0.4rem 0 0;
    font-size: 0.98rem;
    line-height: 1.55;
  }
  @media (max-width: 480px) {
    .timeline {
      --when: 3.25rem;
      --gap: 0.75rem;
    }
  }
</style>
