---
import { TIMELINE } from "../timeline";
---

<section class="timeline" aria-labelledby="timeline-label">
  <div class="head">
    <p class="label" id="timeline-label">the path so far</p>
    <div class="arrows">
      <button type="button" data-dir="-1" aria-label="Earlier">←</button>
      <button type="button" data-dir="1" aria-label="Later">→</button>
    </div>
  </div>

  <ol class="track" tabindex="0" aria-label="Timeline, scroll sideways">
    {
      TIMELINE.map((s, i) => (
        <li class:list={["stop", { now: i === TIMELINE.length - 1 }]}>
          <span class="when">{s.when}</span>
          <span class="dot" aria-hidden="true" />
          <p class="title">{s.title}</p>
          {s.where && (
            <p class="where">{s.href ? <a href={s.href}>{s.where}</a> : s.where}</p>
          )}
          {s.note && <p class="note">{s.note}</p>}
        </li>
      ))
    }
  </ol>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".timeline").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".track")!;
    const [prev, next] = root.querySelectorAll<HTMLButtonElement>(".arrows button");
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    root.querySelectorAll<HTMLButtonElement>(".arrows button").forEach((b) =>
      b.addEventListener("click", () => {
        const step = track.querySelector<HTMLElement>(".stop")?.offsetWidth ?? 200;
        track.scrollBy({ left: Number(b.dataset.dir) * step, behavior: "smooth" });
      }),
    );
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });
</script>

<style>
  .timeline {
    margin: 3rem 0;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .arrows {
    display: flex;
    gap: 0.5rem;
  }
  .arrows button {
    font: inherit;
    font-family: var(--sans);
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--faint);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  .arrows button:hover:not(:disabled),
  .arrows button:focus-visible {
    border-color: var(--accent);
    outline: none;
  }
  .arrows button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .track {
    list-style: none;
    margin: 0;
    padding: 0 0 1rem;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    mask-image: linear-gradient(90deg, #000 85%, transparent);
    /* the line the dots sit on */
    background: linear-gradient(var(--faint), var(--faint)) 0 2.35rem / 100% 1px no-repeat;
    background-attachment: local;
  }
  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  @media (max-width: 480px) {
    .stop {
      flex-basis: 78%;
    }
  }
  .stop {
    flex: 0 0 max(12rem, 42%);
    scroll-snap-align: start;
    padding-right: 1.5rem;
  }
  .when {
    display: block;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    height: 1.6rem;
  }
  .dot {
    display: block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--muted);
    margin: 0.3rem 0 0.9rem;
  }
  .now .dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .now .when {
    color: var(--accent);
  }
  .title {
    margin: 0;
    font-family: var(--sans);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .where {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .note {
    margin: 0.5rem 0 0;
    font-size: 0.98rem;
    line-height: 1.55;
  }
</style>
